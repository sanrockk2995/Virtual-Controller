<Window x:Class="VirtualController.App.Views.InputBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Required" Height="190" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" Text="Enter text:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <TextBox Grid.Row="1" x:Name="TxtInput" Height="34" Margin="0,0,0,16" FontSize="14" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Background="#334155" Margin="0,0,10,0" Width="85" Height="32" Click="BtnCancel_Click"/>
            <Button Content="OK" Background="{StaticResource AccentBlueBrush}" Width="85" Height="32" Click="BtnOK_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
