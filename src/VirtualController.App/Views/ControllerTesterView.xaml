<UserControl x:Class="VirtualController.App.Views.ControllerTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="850">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Controller Live Visualizer &amp; Tester" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Verify your keyboard and mouse conversion into virtual Xbox 360 controller inputs in real-time" 
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Visualizer Area -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Triggers and Bumpers -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Trigger & Bumper -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="LT (Left Trigger)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtLTVal" Text="0%" HorizontalAlignment="Right" Foreground="#38BDF8"/>
                        </Grid>
                        <ProgressBar x:Name="BarLT" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#16161A" Margin="0,0,0,10"/>
                        <Border x:Name="BoxLB" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,4">
                            <TextBlock Text="LB (Left Bumper)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Navigation (Back, Guide, Start) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0">
                        <Border x:Name="BoxBack" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Width="60" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="Back" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <Border x:Name="BoxGuide" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <Border x:Name="BoxStart" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Width="60" Height="36">
                            <TextBlock Text="Start" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Right Trigger & Bumper -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="RT (Right Trigger)" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtRTVal" Text="0%" HorizontalAlignment="Right" Foreground="#38BDF8"/>
                        </Grid>
                        <ProgressBar x:Name="BarRT" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#16161A" Margin="0,0,0,10"/>
                        <Border x:Name="BoxRB" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Height="36" Padding="8,4">
                            <TextBlock Text="RB (Right Bumper)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Middle Row: Sticks and Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Left Stick & D-Pad -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Left Stick (WASD)" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="2" CornerRadius="65" Width="130" Height="130">
                            <Canvas Width="130" Height="130" ClipToBounds="True">
                                <!-- Crosshairs -->
                                <Line X1="0" Y1="65" X2="130" Y2="65" Stroke="#282838" StrokeThickness="1"/>
                                <Line X1="65" Y1="0" X2="65" Y2="130" Stroke="#282838" StrokeThickness="1"/>
                                <!-- Stick Dot -->
                                <Ellipse x:Name="DotLeftStick" Width="18" Height="18" Fill="#38BDF8" Canvas.Left="56" Canvas.Top="56"/>
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="TxtLeftStickCoords" Text="X: 0.00  Y: 0.00" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12"/>
                        <Border x:Name="BoxLS" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                            <TextBlock Text="LS Click" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Column: D-Pad -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="D-Pad" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Grid Width="110" Height="110">
                            <Border x:Name="BoxDPadUp" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Width="32" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <TextBlock Text="▲" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                            <Border x:Name="BoxDPadDown" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Width="32" Height="32" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="▼" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                            <Border x:Name="BoxDPadLeft" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="◀" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                            <Border x:Name="BoxDPadRight" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                            <Border Background="#202028" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Right Column: Face Buttons (Y, X, B, A) & Right Stick -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Face Buttons Diamond -->
                        <TextBlock Text="Face Buttons" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Grid Width="120" Height="120" Margin="0,0,0,12">
                            <!-- Y (Top, Yellow) -->
                            <Border x:Name="BtnY" Width="36" Height="36" CornerRadius="18" Background="#16161A" BorderBrush="#CA8A04" BorderThickness="2" VerticalAlignment="Top" HorizontalAlignment="Center">
                                <TextBlock Text="Y" Foreground="#FACC15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- X (Left, Blue) -->
                            <Border x:Name="BtnX" Width="36" Height="36" CornerRadius="18" Background="#16161A" BorderBrush="#2563EB" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="X" Foreground="#60A5FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- B (Right, Red) -->
                            <Border x:Name="BtnB" Width="36" Height="36" CornerRadius="18" Background="#16161A" BorderBrush="#DC2626" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="B" Foreground="#F87171" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- A (Bottom, Green) -->
                            <Border x:Name="BtnA" Width="36" Height="36" CornerRadius="18" Background="#16161A" BorderBrush="#16A34A" BorderThickness="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="A" Foreground="#4ADE80" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Right Stick (Mouse) -->
                        <TextBlock Text="Right Stick (Mouse)" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <Border Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="2" CornerRadius="55" Width="110" Height="110">
                            <Canvas Width="110" Height="110" ClipToBounds="True">
                                <Line X1="0" Y1="55" X2="110" Y2="55" Stroke="#282838" StrokeThickness="1"/>
                                <Line X1="55" Y1="0" X2="55" Y2="110" Stroke="#282838" StrokeThickness="1"/>
                                <Ellipse x:Name="DotRightStick" Width="16" Height="16" Fill="#4ADE80" Canvas.Left="47" Canvas.Top="47"/>
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="TxtRightStickCoords" Text="X: 0.00  Y: 0.00" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6"/>
                        <Border x:Name="BoxRS" Background="#16161A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                            <TextBlock Text="RS Click" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Bottom Status -->
                <TextBlock Grid.Row="2" Text="Inputs update in real-time while Virtual Controller is enabled. Press Ctrl + Alt + F10 anytime for emergency stop." 
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,16,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
