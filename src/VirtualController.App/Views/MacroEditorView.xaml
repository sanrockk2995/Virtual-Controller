<UserControl x:Class="VirtualController.App.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.Resources>
        <!-- ToggleButton Style for Controller Buttons in Macro Step Builder -->
        <Style x:Key="ControllerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#22222B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Macro_Title}" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Macro_Subtitle}" 
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSave" Content="{DynamicResource Macro_BtnSave}" Background="{StaticResource AccentGreenBrush}" 
                        Padding="16,8" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Layout (2 Columns: Left 300px Macro List, Right * Macro Inspector & Step Builder) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Macro List & Toolbar -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="14" Margin="0,0,12,0" 
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Toolbar -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{DynamicResource Macro_ListHeader}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- Toolbar Row 1: + New & ⚡ Presets -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnNewMacro" Content="{DynamicResource Macro_BtnNew}" 
                                    Background="{StaticResource AccentBlueBrush}" Margin="0,0,4,0" Click="BtnNewMacro_Click"/>
                            <Button Grid.Column="1" x:Name="BtnAddPreset" Content="{DynamicResource Macro_BtnPreset}" 
                                    Background="#334155" Margin="4,0,0,0" Click="BtnAddPreset_Click"/>
                        </Grid>

                        <!-- Toolbar Row 2: Duplicate & Delete -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnDuplicateMacro" Content="{DynamicResource Macro_BtnDuplicate}" 
                                    Background="#334155" Margin="0,0,4,0" Click="BtnDuplicateMacro_Click"/>
                            <Button Grid.Column="1" x:Name="BtnDeleteMacro" Content="{DynamicResource Macro_BtnDelete}" 
                                    Background="{StaticResource AccentRedBrush}" Margin="4,0,0,0" Click="BtnDeleteMacro_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Macro ListBox -->
                    <ListBox Grid.Row="1" x:Name="MacroListBox" Background="#16161A" BorderThickness="0" 
                             Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="MacroListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E24" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" 
                                        BorderBrush="#2D2D38" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- IsEnabled CheckBox -->
                                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Macro Name -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" 
                                                   FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <!-- Mode Badge -->
                                        <Border Grid.Row="0" Grid.Column="2" Background="{Binding ModeBadgeBrush}" 
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModeBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Trigger Input Badge & Step Count -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                            <Border Background="#282838" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⌨ " FontSize="10" Foreground="#A0A0AB"/>
                                                    <TextBlock Text="{Binding TriggerInput}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding StepCountText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Column: Macro Inspector & Step Sequence Builder -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="12,0,0,0" 
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid x:Name="MacroInspectorGrid" IsEnabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 1. Macro Properties Card -->
                            <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,0,0,14" 
                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Macro_EditorHeader}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <!-- Macro Name -->
                                    <TextBlock Text="{DynamicResource Macro_Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtMacroName" TextChanged="TxtMacroName_TextChanged" Margin="0,0,0,10"/>

                                    <!-- Trigger Key & Execution Mode -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Trigger Key -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{DynamicResource Macro_Trigger}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#151518" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                    <TextBlock x:Name="TxtTriggerDisplay" Text="Unassigned" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Grid.Column="1" x:Name="BtnRebindTrigger" Content="{DynamicResource Macro_BtnRebind}" 
                                                        Background="{StaticResource AccentBlueBrush}" Click="BtnRebindTrigger_Click" Margin="6,0,0,0" MinWidth="85"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Execution Mode -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Macro_Mode}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbMacroMode" SelectionChanged="CmbMacroMode_SelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Macro_ModeOnce}"/>
                                                <ComboBoxItem Content="{DynamicResource Macro_ModeHold}"/>
                                                <ComboBoxItem Content="{DynamicResource Macro_ModeToggle}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Enabled CheckBox & Loop Delay -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- IsEnabled CheckBox -->
                                        <CheckBox Grid.Column="0" x:Name="ChkMacroEnabled" Content="{DynamicResource Macro_Enabled}" 
                                                  VerticalAlignment="Center" Checked="ChkMacroEnabled_Changed" Unchecked="ChkMacroEnabled_Changed"/>

                                        <!-- Loop Delay -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Macro_LoopDelay}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtLoopDelay" Width="80" TextChanged="TxtLoopDelay_TextChanged" 
                                                     PreviewTextInput="NumberValidationTextBox"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Add Step / Live Record Card -->
                            <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,0,0,14" 
                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Macro_AddStepTitle}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <!-- Step Type -->
                                    <TextBlock Text="{DynamicResource Macro_StepType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbStepType" SelectionChanged="CmbStepType_SelectionChanged" Margin="0,0,0,10" Width="260" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="{DynamicResource Macro_StepTap}"/>
                                        <ComboBoxItem Content="{DynamicResource Macro_StepHold}"/>
                                        <ComboBoxItem Content="{DynamicResource Macro_StepRelease}"/>
                                        <ComboBoxItem Content="{DynamicResource Macro_StepWait}"/>
                                    </ComboBox>

                                    <!-- Controller Button Multi-Select ToggleButtons -->
                                    <TextBlock Text="{DynamicResource Macro_SelectButtons}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="ButtonSelectorPanel" Margin="0,0,0,10">
                                        <ToggleButton Content="A" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="36"/>
                                        <ToggleButton Content="B" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="36"/>
                                        <ToggleButton Content="X" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="36"/>
                                        <ToggleButton Content="Y" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="36"/>
                                        <ToggleButton Content="LB" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="RB" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="LT" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="RT" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="LS" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="RS" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="38"/>
                                        <ToggleButton Content="Back" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="44"/>
                                        <ToggleButton Content="Start" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="44"/>
                                        <ToggleButton Content="DPadUp" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="58"/>
                                        <ToggleButton Content="DPadDown" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="68"/>
                                        <ToggleButton Content="DPadLeft" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="62"/>
                                        <ToggleButton Content="DPadRight" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="68"/>
                                        <ToggleButton Content="LS_Up" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="54"/>
                                        <ToggleButton Content="LS_Down" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="62"/>
                                        <ToggleButton Content="LS_Left" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="56"/>
                                        <ToggleButton Content="LS_Right" Style="{StaticResource ControllerToggleButtonStyle}" MinWidth="62"/>
                                    </WrapPanel>

                                    <!-- Duration & Delay inputs -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Macro_Duration}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtStepDuration" Text="50" Width="60" Margin="0,0,16,0" 
                                                 PreviewTextInput="NumberValidationTextBox"/>

                                        <TextBlock Text="{DynamicResource Macro_DelayAfter}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="TxtStepDelay" Text="50" Width="60" 
                                                 PreviewTextInput="NumberValidationTextBox"/>
                                    </StackPanel>

                                    <!-- Action Buttons: + Add Step, ⏺ Live Record, Clear Steps -->
                                    <WrapPanel>
                                        <Button x:Name="BtnAddStep" Content="{DynamicResource Macro_BtnAddStep}" 
                                                Background="{StaticResource AccentBlueBrush}" Click="BtnAddStep_Click" Margin="0,0,8,4"/>
                                        <Button x:Name="BtnRecord" Content="{DynamicResource Macro_BtnRecord}" 
                                                Background="#2563EB" Click="BtnRecord_Click" Margin="0,0,8,4"/>
                                        <Button x:Name="BtnClearSteps" Content="{DynamicResource Macro_BtnClearSteps}" 
                                                Background="#334155" Click="BtnClearSteps_Click" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3. Step Sequence Timeline List -->
                            <Border Background="#16161A" CornerRadius="8" Padding="14" 
                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Macro_StepsHeader}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <ItemsControl x:Name="StepsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E1E24" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" 
                                                        BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Index #1 -->
                                                        <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontWeight="Bold" 
                                                                   FontSize="13" Foreground="#A0A0AB" VerticalAlignment="Center"/>

                                                        <!-- StepTypeBadge (TAP, HOLD, RELEASE, WAIT) -->
                                                        <Border Grid.Column="1" Background="{Binding StepTypeBrush}" CornerRadius="4" 
                                                                Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StepTypeBadge}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>

                                                        <!-- ButtonsText -->
                                                        <TextBlock Grid.Column="2" Text="{Binding ButtonsText}" FontWeight="SemiBold" 
                                                                   FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" 
                                                                   Margin="6,0" TextTrimming="CharacterEllipsis"/>

                                                        <!-- Editable DurationMs & DelayAfterMs -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                            <TextBlock Text="Dur:" Foreground="{StaticResource TextSecondaryBrush}" 
                                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding DurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="48" Height="26" Padding="4,2" FontSize="12" Margin="0,0,8,0" 
                                                                     PreviewTextInput="NumberValidationTextBox"/>

                                                            <TextBlock Text="Delay:" Foreground="{StaticResource TextSecondaryBrush}" 
                                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding DelayAfterMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="48" Height="26" Padding="4,2" FontSize="12" 
                                                                     PreviewTextInput="NumberValidationTextBox"/>
                                                        </StackPanel>

                                                        <!-- Step Actions: Up, Down, Delete -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button Content="↑" Tag="{Binding}" Background="#334155" Width="26" Height="26" 
                                                                    Padding="0" Margin="0,0,4,0" ToolTip="Move Up" Click="BtnStepMoveUp_Click"/>
                                                            <Button Content="↓" Tag="{Binding}" Background="#334155" Width="26" Height="26" 
                                                                    Padding="0" Margin="0,0,4,0" ToolTip="Move Down" Click="BtnStepMoveDown_Click"/>
                                                            <Button Content="✕" Tag="{Binding}" Background="{StaticResource AccentRedBrush}" 
                                                                    Width="26" Height="26" Padding="0" ToolTip="Delete Step" Click="BtnStepDelete_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#1E1E28" CornerRadius="6" Padding="12">
            <TextBlock x:Name="StatusInfoText" Text="{DynamicResource Macro_Tip}" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
