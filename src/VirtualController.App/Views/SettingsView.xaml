<UserControl x:Class="VirtualController.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource Settings_Title}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Settings_Subtitle}" 
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Application & System Options -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="0,0,10,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_AppPrefs}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Language Selection -->
                    <TextBlock Text="{DynamicResource Settings_Language}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ComboLanguage" Height="36" Margin="0,0,0,16" SelectionChanged="ComboLanguage_SelectionChanged">
                        <ComboBoxItem Content="Tiếng Việt (Vietnamese)"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkStartWithWindows" Content="{DynamicResource Settings_StartWithWindows}" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Settings_StartWithWindowsDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,14"/>

                    <CheckBox x:Name="ChkStartMinimized" Content="{DynamicResource Settings_StartMinimized}" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Settings_StartMinimizedDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,14"/>

                    <CheckBox x:Name="ChkAutoEnable" Content="{DynamicResource Settings_AutoEnable}" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Settings_AutoEnableDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,14"/>

                    <CheckBox x:Name="ChkBlockKeyboard" Content="{DynamicResource Settings_BlockKeyboard}" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Settings_BlockKeyboardDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,20" TextWrapping="Wrap"/>

                    <TextBlock Text="{DynamicResource Settings_HotkeyTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#16161A" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtHotkeyDisplay" Text="Ctrl + Alt + F10" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="BtnChangeHotkey" Content="{DynamicResource Settings_BtnChangeHotkey}" Height="28" Padding="10,0" Margin="8,0,0,0"
                                        Background="{StaticResource AccentBlueBrush}" FontSize="11" Click="BtnChangeHotkey_Click"/>
                                <Button Grid.Column="2" x:Name="BtnResetHotkey" Content="{DynamicResource Settings_BtnResetHotkey}" Height="28" Padding="10,0" Margin="6,0,0,0"
                                        Background="#334155" FontSize="11" Click="BtnResetHotkey_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtHotkeyHint" Text="{DynamicResource Settings_HotkeyDesc}" 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Driver Diagnosis & Requirements -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="10,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_DriverHealth}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_DriverViGEm}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDriverDiagnosis" Text="Checking..." FontSize="13" Foreground="#4ADE80" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BtnCheckDriver" Content="{DynamicResource Settings_BtnRecheck}" Background="#334155" Margin="0,0,8,0" Click="BtnCheckDriver_Click"/>
                        <Button x:Name="BtnInstallDriver" Content="{DynamicResource Settings_BtnInstall}" Background="{StaticResource AccentBlueBrush}" Click="BtnInstallDriver_Click"/>
                    </StackPanel>

                    <Border Background="#202028" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_DriverInfoTitle}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Settings_DriverInfoDesc}" 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Settings_DriverInfoSafe}" FontSize="11" Foreground="#4ADE80" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Software Updates Card -->
                    <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings_UpdateTitle}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <CheckBox x:Name="ChkAutoCheckUpdates" Content="{DynamicResource Settings_AutoCheckUpdates}" Margin="0,0,0,6" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Settings_AutoCheckUpdatesDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,10" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Version:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentAppVersion" Text="v1.3.1" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtUpdateStatus" Text="Ready to check." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnCheckUpdates" Content="{DynamicResource Settings_BtnCheckUpdate}" Height="30" Padding="12,0" Background="{StaticResource AccentBlueBrush}" FontSize="12" Click="BtnCheckUpdates_Click"/>
                                <Button x:Name="BtnViewUpdate" Content="{DynamicResource Update_BtnDownload}" Height="30" Padding="12,0" Background="{StaticResource AccentGreenBrush}" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnViewUpdate_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Save button at bottom -->
        <Button Grid.Row="2" x:Name="BtnSaveSettings" Content="{DynamicResource Settings_BtnSave}" 
                Background="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" 
                Margin="0,16,0,0" Padding="20,10" Click="BtnSaveSettings_Click"/>
    </Grid>
</UserControl>
