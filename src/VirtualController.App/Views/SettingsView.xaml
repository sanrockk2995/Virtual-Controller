<UserControl x:Class="VirtualController.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings &amp; Environment" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Configure startup preferences, hotkeys and verify virtual controller driver status" 
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Application & System Options -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="0,0,10,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Application Preferences" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Automatically launches VirtualController when Windows starts." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,14"/>

                    <CheckBox x:Name="ChkStartMinimized" Content="Start Minimized to System Tray" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Hides the main window on startup and runs in system tray." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,14"/>

                    <CheckBox x:Name="ChkAutoEnable" Content="Auto-Enable Controller on Startup" Margin="0,0,0,14" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Instantly activates virtual controller mapping upon launching." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,-8,0,20"/>

                    <TextBlock Text="Emergency &amp; Toggle Hotkey" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#16161A" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Ctrl + Alt + F10" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="Global system hook hotkey: press anywhere to instantly freeze/disable virtual gamepad and release all inputs." 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Right: Driver Diagnosis & Requirements -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="10,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Driver &amp; System Health" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Virtual Controller Driver (ViGEmBus):" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDriverDiagnosis" Text="Checking..." FontSize="13" Foreground="#4ADE80" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BtnCheckDriver" Content="Re-Check Driver Status" Background="#334155" Margin="0,0,8,0" Click="BtnCheckDriver_Click"/>
                        <Button x:Name="BtnInstallDriver" Content="Install ViGEmBus Driver" Background="{StaticResource AccentBlueBrush}" Click="BtnInstallDriver_Click"/>
                    </StackPanel>

                    <Border Background="#202028" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Driver Information:" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="This software utilizes the Nefarius ViGEmBus driver to present genuine Xbox 360 controller hardware reports to PC games and Steam titles." 
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="No game files or executables are modified." FontSize="11" Foreground="#4ADE80" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Save button at bottom -->
        <Button Grid.Row="2" x:Name="BtnSaveSettings" Content="Save Application Settings" 
                Background="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" 
                Margin="0,16,0,0" Padding="20,10" Click="BtnSaveSettings_Click"/>
    </Grid>
</UserControl>
