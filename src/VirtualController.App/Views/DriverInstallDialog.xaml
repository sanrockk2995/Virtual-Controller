<Window x:Class="VirtualController.App.Views.DriverInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ViGEmBus Driver Setup"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border Padding="24" Background="{StaticResource BgDarkBrush}">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource AccentBlueBrush}" Margin="0,0,14,0">
                    <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ViGEmBus Driver Setup" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Virtual Xbox 360 Controller Subsystem" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Description Card -->
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ViGEmBus kernel driver is required to emulate an authentic Xbox 360 gamepad for PC games and Steam." 
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="We can download and install the official signed driver from GitHub automatically with 1-click." 
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Status & Progress -->
            <Border Background="#16161A" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="Ready to install official driver." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ProgressBarInstall" Height="6" Margin="0,10,0,0" Visibility="Collapsed" IsIndeterminate="True" Foreground="{StaticResource AccentBlueBrush}"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnManual" Content="Manual Download" Background="#2E3342" Click="BtnManual_Click"/>
                
                <Button Grid.Column="2" x:Name="BtnInstall" Content="Install Automatically" Background="{StaticResource AccentGreenBrush}" 
                        Margin="0,0,10,0" Padding="16,8" Click="BtnInstall_Click"/>

                <Button Grid.Column="3" x:Name="BtnClose" Content="Cancel" Background="#334155" Padding="16,8" Click="BtnClose_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
