<UserControl x:Class="VirtualController.App.Views.AnalogSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Analog Configuration" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Choose Keyboard or Mouse for either thumbstick with fully independent deadzones and sensitivity" 
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnSaveAnalog" Content="Save Analog Settings" 
                    Background="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Click="BtnSaveAnalog_Click"/>
        </Grid>

        <!-- Main Body: Two Flexible Columns -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT STICK ================= -->
                <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="0,0,10,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Left Thumbstick" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Input Source Selector -->
                        <TextBlock Text="Input Source:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboLeftSource" Height="36" Margin="0,0,0,16" SelectionChanged="ComboLeftSource_SelectionChanged">
                            <ComboBoxItem Content="Keyboard (Keys)" IsSelected="True"/>
                            <ComboBoxItem Content="Mouse (Movement)"/>
                        </ComboBox>

                        <!-- LEFT STICK: KEYBOARD PANEL -->
                        <StackPanel x:Name="PanelLeftKeyboard">
                            <TextBlock Text="Directional Keys (Click to rebind):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#16161A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Up:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="0" Grid.Column="1" x:Name="BtnLeftKeyUp" Content="W" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Left_Up"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Down:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="1" Grid.Column="1" x:Name="BtnLeftKeyDown" Content="S" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Left_Down"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Left:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="2" Grid.Column="1" x:Name="BtnLeftKeyLeft" Content="A" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Left_Left"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Right:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="3" Grid.Column="1" x:Name="BtnLeftKeyRight" Content="D" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Left_Right"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Diagonal Normalization: Active (Magnitude ≤ 1.0, W+D = 0.707, 0.707)" FontSize="11" Foreground="#4ADE80" Margin="0,0,0,12"/>

                            <!-- Deadzone -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Deadzone:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftKbdDeadzone" Text="0.10" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftKbdDeadzone" Minimum="0.0" Maximum="0.5" Value="0.10" SmallChange="0.01" LargeChange="0.05" Margin="0,0,0,14" ValueChanged="SliderLeftKbdDeadzone_ValueChanged"/>

                            <!-- Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Sensitivity:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftKbdSens" Text="1.0" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftKbdSens" Minimum="0.1" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,14" ValueChanged="SliderLeftKbdSens_ValueChanged"/>

                            <!-- Curve -->
                            <TextBlock Text="Response Curve:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboLeftKbdCurve" Margin="0,0,0,10">
                                <ComboBoxItem Content="Linear" IsSelected="True"/>
                                <ComboBoxItem Content="Exponential"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- LEFT STICK: MOUSE PANEL -->
                        <StackPanel x:Name="PanelLeftMouse" Visibility="Collapsed">
                            <!-- Mouse Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Overall Sensitivity:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftMouseSens" Text="1.2" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftMouseSens" Minimum="0.1" Maximum="4.0" Value="1.2" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,10" ValueChanged="SliderLeftMouseSens_ValueChanged"/>

                            <!-- X/Y Independent Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="X Sensitivity:" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLeftSensX" Text="1.00" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="SliderLeftSensX" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderLeftSensX_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Y Sensitivity:" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtLeftSensY" Text="1.00" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="SliderLeftSensY" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderLeftSensY_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Anti-Deadzone (Initial Deflection) -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Anti-Deadzone (Initial Deflection):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftAntiDeadzone" Text="0.15" HorizontalAlignment="Right" Foreground="#4ADE80" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock Text="Offsets game deadzone for instant stick movement" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Slider x:Name="SliderLeftAntiDeadzone" Minimum="0.0" Maximum="0.40" Value="0.15" SmallChange="0.01" LargeChange="0.05" Margin="0,0,0,10" ValueChanged="SliderLeftAntiDeadzone_ValueChanged"/>

                            <!-- Response Curve -->
                            <TextBlock Text="Response Curve:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboLeftMouseCurve" Margin="0,0,0,10">
                                <ComboBoxItem Content="Linear" IsSelected="True"/>
                                <ComboBoxItem Content="Delay (Ease-in)"/>
                                <ComboBoxItem Content="Aggressive (Ease-out)"/>
                                <ComboBoxItem Content="Instant"/>
                                <ComboBoxItem Content="Smooth (S-Curve)"/>
                            </ComboBox>

                            <!-- Mouse Deadzone (Noise Gate) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Deadzone (Noise Gate):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftMouseDeadzone" Text="0.05" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftMouseDeadzone" Minimum="0.0" Maximum="0.2" Value="0.05" SmallChange="0.01" LargeChange="0.02" Margin="0,0,0,10" ValueChanged="SliderLeftMouseDeadzone_ValueChanged"/>

                            <!-- Mouse Smoothing -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Smoothing (EMA):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftMouseSmoothing" Text="0.15" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftMouseSmoothing" Minimum="0.0" Maximum="0.8" Value="0.15" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderLeftMouseSmoothing_ValueChanged"/>

                            <!-- Mouse Acceleration -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Acceleration:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLeftMouseAccel" Text="1.0" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderLeftMouseAccel" Minimum="1.0" Maximum="2.5" Value="1.0" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderLeftMouseAccel_ValueChanged"/>

                            <!-- Invert X & Y & Radial Normalization -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <CheckBox x:Name="ChkLeftInvertX" Content="Invert X" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkLeftInvertY" Content="Invert Y" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkLeftIsRadial" Content="Radial Stick (Circle)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Return to Center Behavior -->
                            <TextBlock Text="Return to Center Dynamics:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboLeftReturnToCenter" Margin="0,0,0,10">
                                <ComboBoxItem Content="Instant / Snappy (Zero Drift)" IsSelected="True"/>
                                <ComboBoxItem Content="Smooth Decay"/>
                            </ComboBox>

                            <!-- Reset Defaults Button -->
                            <Button x:Name="BtnLeftResetMouseDefaults" Content="Reset Mouse Settings to Defaults" Background="#282838" Height="28" Margin="0,0,0,4" Click="BtnLeftResetMouseDefaults_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= RIGHT STICK ================= -->
                <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="20" Margin="10,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Right Thumbstick" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Input Source Selector -->
                        <TextBlock Text="Input Source:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboRightSource" Height="36" Margin="0,0,0,16" SelectionChanged="ComboRightSource_SelectionChanged">
                            <ComboBoxItem Content="Mouse (Movement)" IsSelected="True"/>
                            <ComboBoxItem Content="Keyboard (Keys)"/>
                        </ComboBox>

                        <!-- RIGHT STICK: MOUSE PANEL -->
                        <StackPanel x:Name="PanelRightMouse">
                            <!-- Mouse Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Overall Sensitivity:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightMouseSens" Text="1.2" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightMouseSens" Minimum="0.1" Maximum="4.0" Value="1.2" SmallChange="0.05" LargeChange="0.2" Margin="0,0,0,10" ValueChanged="SliderRightMouseSens_ValueChanged"/>

                            <!-- X/Y Independent Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="X Sensitivity:" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtRightSensX" Text="1.00" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="SliderRightSensX" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderRightSensX_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Y Sensitivity:" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtRightSensY" Text="1.00" HorizontalAlignment="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold"/>
                                    </Grid>
                                    <Slider x:Name="SliderRightSensY" Minimum="0.2" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" ValueChanged="SliderRightSensY_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Anti-Deadzone (Initial Deflection) -->
                            <Grid Margin="0,4,0,2">
                                <TextBlock Text="Anti-Deadzone (Initial Deflection):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightAntiDeadzone" Text="0.15" HorizontalAlignment="Right" Foreground="#4ADE80" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock Text="Offsets game deadzone for instant stick movement" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Slider x:Name="SliderRightAntiDeadzone" Minimum="0.0" Maximum="0.40" Value="0.15" SmallChange="0.01" LargeChange="0.05" Margin="0,0,0,10" ValueChanged="SliderRightAntiDeadzone_ValueChanged"/>

                            <!-- Response Curve -->
                            <TextBlock Text="Response Curve:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboRightMouseCurve" Margin="0,0,0,10">
                                <ComboBoxItem Content="Linear" IsSelected="True"/>
                                <ComboBoxItem Content="Delay (Ease-in)"/>
                                <ComboBoxItem Content="Aggressive (Ease-out)"/>
                                <ComboBoxItem Content="Instant"/>
                                <ComboBoxItem Content="Smooth (S-Curve)"/>
                            </ComboBox>

                            <!-- Mouse Deadzone (Noise Gate) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Deadzone (Noise Gate):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightMouseDeadzone" Text="0.05" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightMouseDeadzone" Minimum="0.0" Maximum="0.2" Value="0.05" SmallChange="0.01" LargeChange="0.02" Margin="0,0,0,10" ValueChanged="SliderRightMouseDeadzone_ValueChanged"/>

                            <!-- Mouse Smoothing -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Smoothing (EMA):" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightMouseSmoothing" Text="0.15" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightMouseSmoothing" Minimum="0.0" Maximum="0.8" Value="0.15" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderRightMouseSmoothing_ValueChanged"/>

                            <!-- Mouse Acceleration -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mouse Acceleration:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightMouseAccel" Text="1.0" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightMouseAccel" Minimum="1.0" Maximum="2.5" Value="1.0" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,10" ValueChanged="SliderRightMouseAccel_ValueChanged"/>

                            <!-- Invert X & Y & Radial Normalization -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                <CheckBox x:Name="ChkRightInvertX" Content="Invert X" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkRightInvertY" Content="Invert Y" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="ChkRightIsRadial" Content="Radial Stick (Circle)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Return to Center Behavior -->
                            <TextBlock Text="Return to Center Dynamics:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboRightReturnToCenter" Margin="0,0,0,10">
                                <ComboBoxItem Content="Instant / Snappy (Zero Drift)" IsSelected="True"/>
                                <ComboBoxItem Content="Smooth Decay"/>
                            </ComboBox>

                            <!-- Reset Defaults Button -->
                            <Button x:Name="BtnRightResetMouseDefaults" Content="Reset Mouse Settings to Defaults" Background="#282838" Height="28" Margin="0,0,0,4" Click="BtnRightResetMouseDefaults_Click"/>
                        </StackPanel>

                        <!-- RIGHT STICK: KEYBOARD PANEL -->
                        <StackPanel x:Name="PanelRightKeyboard" Visibility="Collapsed">
                            <TextBlock Text="Directional Keys (Click to rebind):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#16161A" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Up:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="0" Grid.Column="1" x:Name="BtnRightKeyUp" Content="Up" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Right_Up"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Down:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="1" Grid.Column="1" x:Name="BtnRightKeyDown" Content="Down" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Right_Down"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Left:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="2" Grid.Column="1" x:Name="BtnRightKeyLeft" Content="Left" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Right_Left"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Right:" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Button Grid.Row="3" Grid.Column="1" x:Name="BtnRightKeyRight" Content="Right" Height="30" Margin="0,2" Background="#282838" Click="BtnStickKey_Click" Tag="Right_Right"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Diagonal Normalization: Active (Magnitude ≤ 1.0)" FontSize="11" Foreground="#4ADE80" Margin="0,0,0,12"/>

                            <!-- Deadzone -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Deadzone:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightKbdDeadzone" Text="0.10" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightKbdDeadzone" Minimum="0.0" Maximum="0.5" Value="0.10" SmallChange="0.01" LargeChange="0.05" Margin="0,0,0,14" ValueChanged="SliderRightKbdDeadzone_ValueChanged"/>

                            <!-- Sensitivity -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Sensitivity:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtRightKbdSens" Text="1.0" HorizontalAlignment="Right" Foreground="#38BDF8" FontWeight="Bold"/>
                            </Grid>
                            <Slider x:Name="SliderRightKbdSens" Minimum="0.1" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,14" ValueChanged="SliderRightKbdSens_ValueChanged"/>

                            <!-- Curve -->
                            <TextBlock Text="Response Curve:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboRightKbdCurve" Margin="0,0,0,10">
                                <ComboBoxItem Content="Linear" IsSelected="True"/>
                                <ComboBoxItem Content="Exponential"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="#1E1E28" CornerRadius="6" Padding="12">
            <TextBlock x:Name="StatusInfoText" Text="Tip: You can set Left Stick to Mouse and Right Stick to Keyboard, or any combination." 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
