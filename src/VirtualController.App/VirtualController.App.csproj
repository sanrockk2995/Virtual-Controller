<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VirtualController.App</RootNamespace>
    <AssemblyName>VirtualController</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VirtualController.Core\VirtualController.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\profiles\**\*" CopyToOutputDirectory="PreserveNewest" Link="profiles\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\config\**\*" CopyToOutputDirectory="PreserveNewest" Link="config\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
